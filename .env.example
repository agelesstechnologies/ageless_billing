APP_NAME="Ageless Park Billing"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
LOG_CHANNEL=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ageless_park
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Nightly backup (db:backup). Only BACKUP_COPY_TO is normally needed.
# BACKUP_COPY_TO=\\NAS\park-backups    (network share / folder)  or  gdrive:ageless-backups  (rclone remote)
BACKUP_COPY_TO=
BACKUP_RETENTION_DAYS=30
# BACKUP_PATH=
# BACKUP_MYSQLDUMP=C:\xampp\mysql\bin\mysqldump.exe
# BACKUP_MYSQL=C:\xampp\mysql\bin\mysql.exe
# BACKUP_RCLONE=rclone
