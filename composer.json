{
  "name": "ageless/park-billing",
  "type": "project",
  "description": "Park billing, QR wallets, ESP32 redemption and mobile site-staff attendance CRM.",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "bacon/bacon-qr-code": "^3.0",
    "laravel/framework": "^12.0",
    "laravel/tinker": "^3.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": [
      "@php artisan config:clear",
      "@php artisan test"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.2.30"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
